  "narratives": [
    {
      "id": "road_ambush",
      "title": "Ambush on the Road",
      "text": "As you round a bend, a rough-looking figure steps out from the treeline, blade drawn. Bandits have been raiding travelers along this stretch for weeks.",
      "sceneType": "combat"
    },
    {
      "id": "roadside_rest",
      "title": "A Moment's Respite",
      "text": "You find a sheltered campsite off the road. A cold fire pit, some scattered supplies — someone camped here recently. Time to rest and search the area.",
      "sceneType": "rest_and_check"
    },
    {
      "id": "hideout_assault",
      "title": "Into the Den",
      "text": "Following the trail from the road, you discover the bandits' hideout — a cave entrance hidden behind overgrown brush. Multiple voices echo from within. This won't be easy.",
      "sceneType": "combat"
    }
  ],

